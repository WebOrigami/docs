{
  "name": "docs",
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "@weborigami/ori-intro": "github:WebOrigami/ori-intro#7dd72758",
    "@weborigami/origami": "0.7.3",
    "@weborigami/pagefind": "0.0.20",
    "@weborigami/pattern-intro": "github:WebOrigami/pattern-intro#4de23649",
    "@weborigami/samples": "github:WebOrigami/samples#2d376f04",
    "marked": "18.0.13",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@weborigami/screenshot": "0.0.18"
  },
  "scripts": {
    "build": "NODE_ENV=production ori 'copy netlify.js(Origami.jsonKeys(src/site.ori)), clear files:build'",
    "publish": "ori build.ori/",
    "comic-screenshots": "ori copy src/comics/comicScreenshots.ori, src/client/assets/screenshots/comics",
    "example-screenshots": "ori Tree.visit Tree.cache src/exampleScreenshots.ori, src/client/assets/screenshots/examples",
    "start": "ori debug2 src/site.ori"
  }
